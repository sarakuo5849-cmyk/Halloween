# 複製成 .env.local（本機）並在 Vercel → Settings → Environment Variables 設定同樣的值
# .env.local 不要 commit 到 GitHub（Next.js 預設的 .gitignore 已排除）

# --- Supabase（Project Settings → API）---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # 公開值（新專案叫 publishable key）
SUPABASE_SERVICE_ROLE_KEY=            # ⚠ 機密（新專案叫 secret key）。不可加 NEXT_PUBLIC_，不可貼給任何人

# --- 網站網址（OAuth 回呼用，結尾不要加 /）---
APP_URL=https://your-app.vercel.app
CONTACT_EMAIL=                        # 隱私權政策上的聯絡信箱

# --- 加密與排程（node scripts/gen-keys.mjs 產生）---
TOKEN_ENC_KEYS=1:
TOKEN_ENC_CURRENT=1
CRON_SECRET=

# --- Meta（拿到開發者帳號後再填）---
META_APP_ID=
META_APP_SECRET=                      # ⚠ 機密
META_GRAPH_VERSION=v24.0              # 請到 Meta 開發者文件 Changelog 確認目前最新版本

# --- Google / YouTube（Google Cloud Console → 憑證 → OAuth 用戶端）---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                 # ⚠ 機密

# --- 同步配額安全上限（選填）---
YT_DAILY_SYNC_BUDGET=6000
IG_DAILY_SYNC_BUDGET=20000
